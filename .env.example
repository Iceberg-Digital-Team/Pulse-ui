# Valuation API (the ls-instant-valuation-api service)
VITE_API_URL=https://ls-instant-valuation-api.property-ai.co.uk
# Frontend API key (public by nature: it ships in the page)
VITE_API_KEY=
# Origins allowed to drive the live preview (the Property Cockpit), comma separated
VITE_COCKPIT_ORIGINS=http://localhost:3030
# Optional: company slug the home page "See an example" button opens
VITE_DEMO_SLUG=
# Google Maps JavaScript API browser key for the property maps (optional: without it no map is shown).
# Our own key; restrict it to the Maps JavaScript API and to the site's referrers.
VITE_GOOGLE_MAPS_KEY=
# Optional: the site domain; company pages are <slug>.<domain> (default property-ai.co.uk)
VITE_SITE_DOMAIN=

# Address the home page (property-ai.co.uk) "Email us" buttons write to
VITE_CONTACT_EMAIL=
